PORT=8000
UVICORN_RELOAD=false

# Where projects, uploads and renders live. Point this at a mounted volume in
# Docker; leave unset for local development and it uses the repo checkout.
AUTOCUT_DATA_DIR=

# Azure Speech (transcription)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# Optional: use a custom/private endpoint instead of the regional one.
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_LANGUAGE=en-US
# Optional: comma-separated locales to auto-detect between, e.g. en-US,es-ES,fr-FR
AZURE_SPEECH_CANDIDATE_LOCALES=

# OpenAI (edit reasoning: speech filter, visual plans, insertion suggestions)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
