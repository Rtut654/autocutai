BACKEND_PORT=8000
WEB_PORT=3000

# Set this to your public backend URL if the web app starts calling the API
# directly from the browser, for example: http://YOUR_VM_IP:8000
NEXT_PUBLIC_API_BASE_URL=

# Azure Speech (transcription)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_LANGUAGE=en-US
AZURE_SPEECH_CANDIDATE_LOCALES=

# OpenAI (edit reasoning)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Sign-in verification. Tokens from Google/Apple are checked against these.
# Google: every OAuth client ID whose tokens you accept (iOS, web, Android).
GOOGLE_CLIENT_IDS=643423102814-odqhn4m5k5jq7uuoitvbpolcvmhpfe94.apps.googleusercontent.com
# Apple: the iOS bundle ID, plus a Services ID if the web app uses Apple.
APPLE_AUDIENCES=com.bestshotai.app

# Session lifetimes in days.
AUTOCUT_ACCESS_TOKEN_DAYS=30
AUTOCUT_REFRESH_TOKEN_DAYS=90

# Leave false. When true, any signed-in user can grant themselves a paid plan
# because nothing verifies the purchase. Only for internal testing.
AUTOCUT_ALLOW_UNVERIFIED_PURCHASES=false
