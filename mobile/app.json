{
  "expo": {
    "name": "AutoCutAI",
    "slug": "autocutai",
    "version": "1.0.0",
    "scheme": "autocutai",
    "icon": "./assets/app_icon.png",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bestshotai.app"
    },
    "android": {
      "package": "com.bestshotai.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app_icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-apple-authentication"
    ]
  }
}
