# Base URL of the AutoCutAI backend.
# Simulator against a local backend: http://127.0.0.1:8000
# Physical device: your machine's LAN IP, e.g. http://192.168.1.20:8000
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Google Sign-In client IDs (optional; email and Apple sign-in work without them)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
